# server base config
NODE_ENV=development
PORT=3000
LOG_LEVELS=log,error,warn,debug

# database config
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=bumpa
DATABASE_PASSWORD=bumpa
DATABASE_NAME=bumpa_ecommerce
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=false

# queue/cache config
REDIS_HOST=localhost
REDIS_PORT=6379
BULLMQ_PREFIX=bull
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25

# paystack gateway config
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYSTACK_TRANSFER_SOURCE=balance
PAYSTACK_CURRENCY=NGN

# knobs
PROGRESSION_DEFINITION_LOADERS_ENABLED=true
CASHBACK_PROCESSING_STALE_AFTER_SECONDS=300
